---
/**
 * Birds-eye overview grid for the bottom of /projects. Dark full-bleed
 * frame matching Workbench.astro's "skill board" on /bio (same --board
 * background, same eyebrow/heading/tally header language).
 *
 * Each card shows the project's real photo by default; hovering reveals a
 * Details-card-style gray panel with the real brand logo and three facts
 * hand-picked from that project's own results — not a generic skill score.
 */
import type { Project } from "../types";
import type { Lang } from "../lib/i18n";
import { ui } from "../i18n/ui";

interface Props {
  projects: Project[];
  projectsBase: string;
  lang: Lang;
}

const { projects, projectsBase, lang } = Astro.props;
const t = ui[lang].projectsGrid;

// Real, cropped brand logos (transparent PNGs cut from the Details-card
// heroes, or the actual asset for icanspeak/colevitate). NimbusVault has no
// public brand, so its mark is generated inline below instead of a file.
const LOGOS: Partial<Record<string, string>> = {
  innate: "/images/logos/innate.png",
  ironandzen: "/images/logos/ironandzen.png",
  pflegeplace: "/images/logos/pflegeplace.png",
  icanspeak: "/images/logos/icanspeak.svg",
  deutschacademy: "/images/logos/deutschacademy.png",
  nomavillage: "/images/logos/nomavillage.png",
  narangyoga: "/images/logos/narangyoga.png",
  colevitate: "/images/logos/colevitate.png",
};

// bioImage is a photo of Edgar himself for ironandzen (he's the facilitator)
// — use a real retreat photo instead for the card face.
const PHOTO_OVERRIDE: Partial<Record<string, string>> = {
  ironandzen: "/images/ironandzen/hero-fire.jpg",
};

// Hand-picked from each project's own `achievements` — the concrete proof
// points a prospective client would actually weigh, not a generic skill
// score. Three per project, none padded to look "full."
const FACTS_EN: Record<string, { value: string; label: string }[]> = {
  innate: [
    { value: "Sold out", label: "every cohort" },
    { value: "Excellent", label: "guest reviews" },
    { value: "High", label: "repeat-guest retention" },
  ],
  ironandzen: [
    { value: "120+", label: "men hosted across cohorts" },
    { value: "5.0★", label: "average rating" },
    { value: "100%", label: "applications hand-vetted" },
  ],
  pflegeplace: [
    { value: "0→1", label: "automation stack, self-built" },
    { value: "↓ CPL", label: "cost-per-lead via targeting" },
    { value: "Nurses placed", label: "into German hospitals" },
  ],
  icanspeak: [
    { value: "0→1", label: "school launched and scaled" },
    { value: "100s", label: "students enrolled" },
    { value: "LinkedIn", label: "outbound pipeline built" },
  ],
  deutschacademy: [
    { value: "Founded", label: "brick-and-mortar school" },
    { value: "Investors", label: "secured" },
    { value: "Hospital clients", label: "acquired as partners" },
  ],
  nomavillage: [
    { value: "172", label: "guests from 27 countries" },
    { value: "4.8★", label: "Google rating" },
    { value: "€700+", label: "cheaper than DIY Lisbon" },
  ],
  narangyoga: [
    { value: "0→1", label: "brand identity, name to voice" },
    { value: "Grown", label: "social audience" },
    { value: "Automated", label: "lead funnel" },
  ],
  colevitate: [
    { value: "4", label: "assessments live, end-to-end" },
    { value: "Solo-built", label: "auth + database layer" },
    { value: "Shipped", label: "in a single build cycle" },
  ],
  nimbusvault: [
    { value: "In production", label: "client IT department" },
    { value: "Audit-logged", label: "every credential reveal" },
    { value: "EN / DE", label: "live UI toggle" },
  ],
};

const FACTS_DE: Record<string, { value: string; label: string }[]> = {
  innate: [
    { value: "Ausgebucht", label: "jede Kohorte" },
    { value: "Exzellent", label: "Gästebewertungen" },
    { value: "Hoch", label: "Wiederkehrquote der Gäste" },
  ],
  ironandzen: [
    { value: "120+", label: "Männer über alle Kohorten hinweg begleitet" },
    { value: "5.0★", label: "Durchschnittsbewertung" },
    { value: "100%", label: "Bewerbungen manuell geprüft" },
  ],
  pflegeplace: [
    { value: "0→1", label: "Automatisierungs-Stack, selbst gebaut" },
    { value: "↓ CPL", label: "Cost-per-Lead durch gezieltes Targeting" },
    { value: "Pflegekräfte vermittelt", label: "an deutsche Kliniken" },
  ],
  icanspeak: [
    { value: "0→1", label: "Schule gegründet und skaliert" },
    { value: "Hunderte", label: "eingeschriebene Studierende" },
    { value: "LinkedIn", label: "Outbound-Pipeline aufgebaut" },
  ],
  deutschacademy: [
    { value: "Gegründet", label: "Präsenz-Sprachschule" },
    { value: "Investoren", label: "gewonnen" },
    { value: "Klinik-Partner", label: "als Kunden gewonnen" },
  ],
  nomavillage: [
    { value: "172", label: "Gäste aus 27 Ländern" },
    { value: "4.8★", label: "Google-Bewertung" },
    { value: "€700+", label: "günstiger als Lissabon in Eigenregie" },
  ],
  narangyoga: [
    { value: "0→1", label: "Markenidentität, vom Namen bis zur Stimme" },
    { value: "Gewachsen", label: "Social-Media-Reichweite" },
    { value: "Automatisiert", label: "Lead-Funnel" },
  ],
  colevitate: [
    { value: "4", label: "Assessments live, End-to-End" },
    { value: "Solo gebaut", label: "Auth- und Datenbank-Layer" },
    { value: "Ausgeliefert", label: "in einem einzigen Build-Zyklus" },
  ],
  nimbusvault: [
    { value: "In Produktion", label: "IT-Abteilung des Kunden" },
    { value: "Audit-geloggt", label: "jede Zugangsdaten-Anzeige" },
    { value: "EN / DE", label: "Live-UI-Umschalter" },
  ],
};

const FACTS = lang === "de" ? FACTS_DE : FACTS_EN;
---

<section class="grid-breakout" data-reveal="fade-up">
  <div class="overview">
    <header class="ov-head">
      <div class="ov-heading">
        <p class="ov-eyebrow">{t.eyebrow}</p>
        <h2>{t.title}</h2>
        <p class="ov-tagline">{t.tagline}</p>
      </div>
      <div class="ov-tally">{projects.length} {t.tally}</div>
    </header>

    <div class="ov-grid">
      {
        projects.map((p) => {
          const photo = PHOTO_OVERRIDE[p.slug] ?? p.bioImage;
          const logo = LOGOS[p.slug];
          const facts = FACTS[p.slug] ?? [];
          return (
            <a class="stat-card" href={`${projectsBase}/${p.slug}`}>
              <img class="stat-photo" src={photo} alt={p.company} loading="lazy" />
              <span class="stat-caption">{p.company}</span>
              <div class="stat-panel">
                <div class="stat-head">
                  <span class="stat-logo-chip">
                    {logo ? (
                      <img class="stat-logo" src={logo} alt="" aria-hidden="true" />
                    ) : (
                      <svg class="stat-logo" viewBox="0 0 64 64" aria-hidden="true">
                        <rect x="4" y="4" width="56" height="56" rx="14" fill="#334155" />
                        <circle cx="32" cy="32" r="16" fill="none" stroke="#94a3b8" stroke-width="3" />
                        <circle cx="32" cy="32" r="5" fill="#3b82f6" />
                      </svg>
                    )}
                  </span>
                  <div>
                    <h3>{p.company}</h3>
                    <span class="stat-sub">{p.title}</span>
                  </div>
                </div>
                <ul class="fact-list">
                  {facts.map((f) => (
                    <li>
                      <span class="fact-value">{f.value}</span>
                      <span class="fact-label">{f.label}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .grid-breakout {
    position: relative;
    left: 50%;
    right: 50%;
    width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
    margin-top: var(--space-7);
    margin-bottom: var(--space-7);
    overflow-anchor: none;
  }

  .overview {
    --board: #23261f;
    --hole: #171912;
    --ov-text: #eeece3;
    --ov-muted: #a4a495;
    --ov-accent: var(--accent);
    background:
      radial-gradient(circle at center, var(--hole) 0 2.2px, transparent 2.3px) 0 0/34px 34px,
      var(--board);
    color: var(--ov-text);
    padding: var(--space-7) clamp(1rem, 4vw, 3rem) var(--space-8);
  }

  .ov-head {
    max-width: 1160px;
    margin: 0 auto;
    padding-bottom: var(--space-6);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .ov-eyebrow {
    font-family: var(--font-logo);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ov-accent);
    margin: 0 0 var(--space-2);
  }

  .ov-head h2 {
    font-family: var(--font-logo);
    font-weight: 700;
    font-size: clamp(1.9rem, 4.6vw, 3.1rem);
    letter-spacing: -0.01em;
    line-height: 1.02;
    margin: 0 0 var(--space-2);
    text-wrap: balance;
  }

  .ov-tagline {
    font-size: 0.9rem;
    color: var(--ov-muted);
    max-width: 38ch;
    line-height: 1.55;
    margin: 0;
  }

  .ov-tally {
    font-family: monospace;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ov-accent);
    white-space: nowrap;
  }

  .ov-grid {
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  @media (max-width: 800px) {
    .ov-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .ov-grid {
      grid-template-columns: 1fr;
    }
  }

  .stat-card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .stat-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .stat-card:hover .stat-photo,
  .stat-card:focus-visible .stat-photo {
    transform: scale(1.04);
  }

  .stat-caption {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .stat-card:hover .stat-caption,
  .stat-card:focus-visible .stat-caption {
    opacity: 0;
  }

  .stat-panel {
    position: absolute;
    inset: 0;
    background: #5f6867;
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .stat-card:hover .stat-panel,
  .stat-card:focus-visible .stat-panel {
    opacity: 1;
  }

  .stat-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .stat-logo-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    background: #fff;
    border-radius: 8px;
    padding: 6px;
  }

  .stat-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .stat-head h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
  }

  .stat-sub {
    font-size: 0.68rem;
    color: #c9cfce;
  }

  .fact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .fact-list li {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .fact-value {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--accent);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .fact-label {
    font-size: 0.72rem;
    color: #dfe3e2;
    line-height: 1.3;
  }
</style>
