---
import { diagnosticCopy } from "../lib/diagnostic";

interface Props {
  lang: "en" | "de";
}

const { lang } = Astro.props;
const c = diagnosticCopy[lang];
const CONTACT_EMAIL = "hello@edgarkretschmann.com";
const MAIL_SUBJECT =
  lang === "de" ? "Anfrage nach meinem Marketing-Diagnose-Ergebnis" : "Following up on my marketing diagnostic";

const clientCopy = {
  scoreLabels: c.scoreLabels,
  gapsHeading: c.gapsHeading,
  recommendationHeading: c.recommendationHeading,
  cta: c.cta,
  disclaimer: c.disclaimer,
  loadingSteps: c.loadingSteps,
  error: c.error,
  contactEmail: CONTACT_EMAIL,
  mailSubject: MAIL_SUBJECT,
  start: c.start,
  close: c.close,
};

type QuestionKey = "industry" | "leadSource" | "bottleneck";
const questionKeys: QuestionKey[] = ["industry", "leadSource", "bottleneck"];
---

<section class="diagnostic" id="diagnostic" data-reveal="fade-up" data-copy={JSON.stringify(clientCopy)}>
  <div class="diagnostic-head">
    <p class="eyebrow">{c.eyebrow}</p>
    <h2>{c.heading}</h2>
    <p class="diagnostic-sub">{c.sub}</p>
    <button
      type="button"
      class="btn-pill btn-accent diagnostic-toggle"
      id="diagnostic-toggle"
      aria-expanded="false"
      aria-controls="diagnostic-panel"
    >
      <span data-label>{c.start}</span>
    </button>
  </div>

  <div class="diagnostic-panel" id="diagnostic-panel">
    <div class="diagnostic-panel-inner">
      <form class="diagnostic-form" id="diagnostic-form" novalidate>
        <input type="hidden" name="lang" value={lang} />
        <input type="text" name="website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />

        {
          questionKeys.map((key) => (
            <fieldset>
              <legend>{c.questions[key].label}</legend>
              <div class="pill-group">
                {Object.entries(c.questions[key].options).map(([value, label]) => (
                  <label class="pill">
                    <input type="radio" name={key} value={value} required />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))
        }

        <button type="submit" class="btn-pill btn-accent diagnostic-submit">{c.submit}</button>
        <p id="diagnostic-status" class="diagnostic-status" role="status" aria-live="polite"></p>

        <div class="diagnostic-output">
          <div class="diagnostic-loading" id="diagnostic-loading" hidden>
            <div class="loading-graphic" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <p class="loading-step" id="diagnostic-loading-step"></p>
          </div>

          <div class="diagnostic-result" id="diagnostic-result" hidden></div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { diagnosticRequestSchema } from "../lib/diagnostic";
  import { runDiagnostic, overallScore } from "../lib/diagnosticEngine";

  const section = document.getElementById("diagnostic") as HTMLElement;
  const toggle = document.getElementById("diagnostic-toggle") as HTMLButtonElement;
  const panel = document.getElementById("diagnostic-panel") as HTMLDivElement;
  const toggleLabel = toggle?.querySelector("[data-label]") as HTMLSpanElement;
  const form = document.getElementById("diagnostic-form");
  const status = document.getElementById("diagnostic-status");
  const submitBtn = form?.querySelector<HTMLButtonElement>(".diagnostic-submit");
  const loadingBox = document.getElementById("diagnostic-loading") as HTMLDivElement;
  const loadingStepEl = document.getElementById("diagnostic-loading-step") as HTMLParagraphElement;
  const resultBox = document.getElementById("diagnostic-result") as HTMLDivElement;
  const copy = JSON.parse(section?.dataset.copy || "{}");

  let loadingTimer: ReturnType<typeof setInterval> | undefined;

  function escapeHtml(value: string) {
    const div = document.createElement("div");
    div.textContent = value;
    return div.innerHTML;
  }

  function runLoadingSequence(onDone: () => void) {
    const steps: string[] = copy.loadingSteps?.length ? copy.loadingSteps : ["…"];
    let i = 0;
    loadingStepEl.textContent = steps[0];
    loadingBox.hidden = false;
    loadingTimer = setInterval(() => {
      i += 1;
      if (i >= steps.length) {
        clearInterval(loadingTimer);
        loadingBox.hidden = true;
        onDone();
        return;
      }
      loadingStepEl.textContent = steps[i];
    }, 380);
  }

  function renderResult(result: ReturnType<typeof runDiagnostic>, overall: number) {
    if (!resultBox) return;
    const scoreCards = (
      [
        ["trafficCapture", copy.scoreLabels.trafficCapture],
        ["leadCapture", copy.scoreLabels.leadCapture],
        ["followUp", copy.scoreLabels.followUp],
      ] as const
    )
      .map(([key, label]) => {
        const score = Math.max(0, Math.min(100, Math.round(result.scores[key])));
        return `
          <div class="score-card">
            <span class="score-value">${score}</span>
            <span class="score-label">${escapeHtml(label)}</span>
            <div class="score-bar"><span style="width:${score}%"></span></div>
          </div>`;
      })
      .join("");

    const gapItems = result.gaps.map((gap) => `<li>${escapeHtml(gap)}</li>`).join("");
    const mailBody = `${result.verdict}\n\n${result.recommendation}`;
    const mailHref = `mailto:${copy.contactEmail}?subject=${encodeURIComponent(copy.mailSubject)}&body=${encodeURIComponent(mailBody)}`;

    resultBox.innerHTML = `
      <div class="result-top">
        <p class="result-overall">${overall}<span>/100</span></p>
        <p class="result-verdict">${escapeHtml(result.verdict)}</p>
      </div>
      <div class="result-scores">${scoreCards}</div>
      <div class="result-block">
        <p class="result-heading">${escapeHtml(copy.gapsHeading)}</p>
        <ul class="result-gaps">${gapItems}</ul>
      </div>
      <div class="result-block">
        <p class="result-heading">${escapeHtml(copy.recommendationHeading)}</p>
        <p class="result-recommendation">${escapeHtml(result.recommendation)}</p>
      </div>
      <div class="result-footer">
        <a class="btn-pill btn-accent result-cta" href="${mailHref}">${escapeHtml(copy.cta)}</a>
        <p class="result-disclaimer">${escapeHtml(copy.disclaimer)}</p>
      </div>
    `;
    resultBox.hidden = false;
    resultBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  toggle?.addEventListener("click", () => {
    const isOpen = panel.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(isOpen));
    if (toggleLabel) toggleLabel.textContent = isOpen ? copy.close : copy.start;
    if (isOpen) {
      panel.addEventListener("transitionend", () => panel.scrollIntoView({ behavior: "smooth", block: "nearest" }), {
        once: true,
      });
    }
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!status || !(form instanceof HTMLFormElement)) return;

    const data = new FormData(form);
    const payload = {
      industry: data.get("industry"),
      leadSource: data.get("leadSource"),
      bottleneck: data.get("bottleneck"),
      lang: data.get("lang"),
      website: data.get("website") || "",
    };

    if (!payload.industry || !payload.leadSource || !payload.bottleneck) {
      status.textContent = "";
      form.reportValidity();
      return;
    }

    // honeypot tripped — pretend nothing happened, same as a real failure
    if (payload.website) {
      status.textContent = copy.error;
      return;
    }

    const parsed = diagnosticRequestSchema.safeParse(payload);
    if (!parsed.success) {
      status.textContent = copy.error;
      return;
    }

    status.textContent = "";
    resultBox.hidden = true;
    if (submitBtn) submitBtn.disabled = true;

    runLoadingSequence(() => {
      const result = runDiagnostic(parsed.data);
      renderResult(result, overallScore(result.scores));
      if (submitBtn) submitBtn.disabled = false;
    });
  });
</script>

<style>
  .diagnostic {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--line);
  }

  .diagnostic-head {
    max-width: 56ch;
    margin: 0 0 var(--space-6);
  }

  .diagnostic-head h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 500;
    margin: var(--space-3) 0 var(--space-3);
  }

  .diagnostic-sub {
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .diagnostic-toggle {
    margin-top: var(--space-4);
  }

  .diagnostic-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s ease;
  }

  .diagnostic-panel.is-open {
    grid-template-rows: 1fr;
  }

  .diagnostic-panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  .diagnostic-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-6);
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }

  legend {
    padding: 0;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pill {
    position: relative;
  }

  .pill input {
    position: absolute;
    opacity: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }

  .pill span {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--text-muted);
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .pill input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .pill input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .diagnostic-submit {
    align-self: flex-start;
    background: var(--accent);
    color: var(--accent-foreground);
    border: 1px solid var(--accent);
  }

  .diagnostic-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .diagnostic-status {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
    min-height: 1.2em;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .diagnostic-output {
    margin-top: var(--space-5);
  }

  /* Loading state */

  .diagnostic-loading {
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-2);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .loading-graphic {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 28px;
  }

  .loading-graphic span {
    width: 6px;
    border-radius: 999px;
    background: var(--accent);
    animation: diagnostic-bounce 0.9s ease-in-out infinite;
  }

  .loading-graphic span:nth-child(1) {
    animation-delay: 0s;
  }
  .loading-graphic span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .loading-graphic span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes diagnostic-bounce {
    0%,
    100% {
      height: 8px;
      opacity: 0.5;
    }
    50% {
      height: 28px;
      opacity: 1;
    }
  }

  .loading-step {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
    min-height: 1.2em;
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-graphic span {
      animation: none;
      height: 18px;
      opacity: 0.8;
    }
  }

  /* Result state */

  .diagnostic-result {
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-2);
  }

  /* Result content below is injected via innerHTML at runtime, so it never
     receives Astro's scoped data-astro-cid attribute — these rules must be
     :global() or they silently never match. */

  :global(.result-top) {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-5);
  }

  :global(.result-overall) {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 600;
    line-height: 1;
    margin: 0 0 var(--space-2);
  }

  :global(.result-overall span) {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-left: 4px;
  }

  :global(.result-verdict) {
    font-size: 1.15rem;
    font-weight: 500;
    max-width: 48ch;
    margin: 0;
  }

  :global(.result-scores) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  :global(.score-card) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) - 4px);
  }

  :global(.score-value) {
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1;
  }

  :global(.score-label) {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  :global(.score-bar) {
    height: 6px;
    border-radius: 999px;
    background: var(--line);
    overflow: hidden;
    margin-top: 4px;
  }

  :global(.score-bar span) {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
  }

  :global(.result-block) {
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    margin-bottom: var(--space-5);
  }

  :global(.result-heading) {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
  }

  :global(.result-gaps) {
    margin: 0;
    padding-left: 1.2em;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.result-recommendation) {
    margin: 0;
    font-size: 1rem;
  }

  :global(.result-footer) {
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  :global(.result-cta) {
    display: inline-flex;
  }

  :global(.result-disclaimer) {
    margin: var(--space-4) 0 0;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    :global(.result-scores) {
      grid-template-columns: 1fr;
    }
  }
</style>
