---
import "../styles/global.css";
import type { Lang } from "../lib/i18n";
import { altLocalePath } from "../lib/i18n";
import { ui, languageLabels } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  section: "home" | "portfolio" | "projects" | "bio";
  lang?: Lang;
  ogImage?: string;
}

const { title, description, section, lang = "en", ogImage = "/seo/share.jpg" } = Astro.props;
const t = ui[lang];

const nav = [
  { href: lang === "en" ? "/" : "/de", label: t.nav.home },
  { href: lang === "en" ? "/portfolio" : "/de/portfolio", label: t.nav.portfolio },
  { href: lang === "en" ? "/projects" : "/de/projects", label: t.nav.projects },
  { href: lang === "en" ? "/bio" : "/de/bio", label: t.nav.bio },
];

const alt = altLocalePath(Astro.url.pathname);
const enPath = lang === "en" ? Astro.url.pathname : alt.path;
const dePath = lang === "de" ? Astro.url.pathname : alt.path;
---

<!doctype html>
<html lang={lang} data-section={section}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/seo/favicon.png" />
    <link rel="apple-touch-icon" href="/seo/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="en" href={enPath} />
    <link rel="alternate" hreflang="de" href={dePath} />
    <link rel="alternate" hreflang="x-default" href={enPath} />
    <script is:inline>
      (function () {
        try {
          var KEY = "lang-pref";
          var saved = localStorage.getItem(KEY);
          var onGerman = location.pathname === "/de" || location.pathname.indexOf("/de/") === 0;
          if (!saved) {
            var prefersGerman = (navigator.language || "").toLowerCase().indexOf("de") === 0;
            if (prefersGerman && !onGerman) {
              localStorage.setItem(KEY, "de");
              location.replace("/de" + location.pathname + location.search);
              return;
            }
            localStorage.setItem(KEY, onGerman ? "de" : "en");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-section={section}>
    <nav class="site-nav" aria-label={t.nav.primary}>
      <a class="site-nav__brand" href={lang === "en" ? "/" : "/de"}>Edgar Kretschmann</a>
      <button
        type="button"
        class="site-nav__toggle"
        id="site-nav-toggle"
        aria-expanded="false"
        aria-controls="site-nav-menu"
        aria-label={t.nav.menu}
      >
        <span class="site-nav__toggle-bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
      <ul id="site-nav-menu" hidden>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={item.href === Astro.url.pathname ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="site-nav__lang">
          <a
            href={enPath}
            aria-current={lang === "en" ? "true" : undefined}
            onclick="try{localStorage.setItem('lang-pref','en')}catch(e){}"
          >
            {languageLabels.en}
          </a>
          <span aria-hidden="true">/</span>
          <a
            href={dePath}
            aria-current={lang === "de" ? "true" : undefined}
            onclick="try{localStorage.setItem('lang-pref','de')}catch(e){}"
          >
            {languageLabels.de}
          </a>
        </li>
        <li>
          <a class="site-nav__cta" href="mailto:hello@edgarkretschmann.com">{t.nav.cta}</a>
        </li>
      </ul>
    </nav>
    <slot />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/nav.ts"></script>
  </body>
</html>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .site-nav__brand {
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .site-nav a:hover {
    color: var(--text);
  }

  .site-nav a[aria-current="page"] {
    color: var(--text);
    font-weight: 600;
  }

  .site-nav__cta {
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 8px 16px;
    font-size: 0.75rem !important;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text) !important;
  }

  .site-nav__cta:hover {
    background: var(--ink);
    color: var(--bg) !important;
    border-color: var(--ink);
  }

  .site-nav__lang {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem !important;
  }

  .site-nav__lang a {
    font-size: 0.75rem;
  }

  .site-nav__lang a[aria-current="true"] {
    color: var(--text);
    font-weight: 600;
  }

  .site-nav__lang span {
    color: var(--line);
  }

  .site-nav ul[hidden] {
    display: none;
  }

  @media (min-width: 641px) {
    .site-nav ul[hidden] {
      display: flex;
    }
  }

  .site-nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    flex-shrink: 0;
  }

  .site-nav__toggle-bars {
    position: relative;
    display: block;
    width: 16px;
    height: 11px;
  }

  .site-nav__toggle-bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--text);
    transition:
      transform 0.2s ease,
      opacity 0.15s ease,
      top 0.2s ease;
  }

  .site-nav__toggle-bars span:nth-child(1) {
    top: 0;
  }

  .site-nav__toggle-bars span:nth-child(2) {
    top: 5px;
  }

  .site-nav__toggle-bars span:nth-child(3) {
    top: 10px;
  }

  .site-nav.is-open .site-nav__toggle-bars span:nth-child(1) {
    top: 5px;
    transform: rotate(45deg);
  }

  .site-nav.is-open .site-nav__toggle-bars span:nth-child(2) {
    opacity: 0;
  }

  .site-nav.is-open .site-nav__toggle-bars span:nth-child(3) {
    top: 5px;
    transform: rotate(-45deg);
  }

  @media (max-width: 640px) {
    .site-nav {
      padding: var(--space-3) var(--space-3);
      flex-wrap: wrap;
    }

    .site-nav__toggle {
      display: inline-flex;
    }

    .site-nav ul {
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin-top: var(--space-3);
      padding-top: var(--space-3);
      border-top: 1px solid var(--line);
    }

    .site-nav ul > li {
      width: 100%;
    }

    .site-nav ul > li > a:not(.site-nav__cta) {
      display: block;
      padding: var(--space-3) 0;
    }

    .site-nav__lang {
      padding: var(--space-3) 0;
      gap: var(--space-2);
    }

    .site-nav__cta {
      display: inline-flex;
      margin: var(--space-2) 0 var(--space-3);
    }
  }
</style>
