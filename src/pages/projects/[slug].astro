---
import Base from "../../layouts/Base.astro";
import RadarChart from "../../components/RadarChart.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: index > 0 ? projects[index - 1] : undefined,
      next: index < projects.length - 1 ? projects[index + 1] : undefined,
    },
  }));
}

const { project, prev, next } = Astro.props;
---

<Base
  title={`${project.company} — Edgar Kretschmann`}
  description={`${project.title}: ${project.bioRole} at ${project.company}.`}
  section="projects"
>
  <main class="wrap">
    <div class="nav-strip nav-strip--top" data-reveal="fade-up">
      {
        prev ? (
          <a href={`/projects/${prev.slug}`}>← {prev.company}</a>
        ) : (
          <a href="/portfolio">← Portfolio</a>
        )
      }
      <a href="/portfolio" class="nav-strip__mid">All projects</a>
      {next && <a href={`/projects/${next.slug}`}>{next.company} →</a>}
    </div>

    <section class="head" data-reveal="fade-up">
      <p class="eyebrow">{project.url}</p>
      <h1>
        {project.company}
        {project.status === "next" && <span class="status-badge">In progress</span>}
      </h1>
      <p class="subtitle">{project.title}</p>
    </section>

    <div class="media" data-reveal="zoom-blur">
      <img src={project.projectsHeroImage} alt={project.title} />
    </div>

    <section class="narrative" data-reveal="fade-up">
      <div class="narrative-block">
        <h3>The challenge</h3>
        <p>{project.challenge}</p>
      </div>
      <div class="narrative-block">
        <h3>The approach</h3>
        <ul>
          {project.approach.map((step) => (
            <li>{step}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="stats" data-reveal="fade-up">
      <div>
        <h3>{project.status === "next" ? "What's next" : "Outcome"}</h3>
        <ul>
          {project.achievements.map((a) => (
            <li>{a}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Tech stack</h3>
        <div class="tags">
          {project.tech.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </div>
      <div class="radar">
        <h3>Skill set</h3>
        <RadarChart points={project.skills} size={180} fillColor="rgba(226,181,61,0.15)" strokeColor="#e2b53d" />
      </div>
    </section>

    <div class="nav-strip nav-strip--bottom" data-reveal="fade-up">
      {
        prev ? (
          <a href={`/projects/${prev.slug}`}>← {prev.company}</a>
        ) : (
          <a href="/portfolio">← Portfolio</a>
        )
      }
      <a href="/portfolio" class="nav-strip__mid">All projects</a>
      {next && <a href={`/projects/${next.slug}`}>{next.company} →</a>}
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .nav-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.85rem;
    flex-wrap: wrap;
  }

  .nav-strip a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .nav-strip a:hover {
    color: var(--text);
  }

  .nav-strip__mid {
    font-weight: 600;
    color: var(--text) !important;
  }

  .nav-strip--top {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .nav-strip--bottom {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .head h1 {
    font-size: clamp(2.4rem, 7vw, 4rem);
    font-weight: 500;
    margin: var(--space-3) 0 var(--space-2);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .status-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 4px 12px;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin: 0;
  }

  .media {
    border-radius: var(--radius);
    overflow: hidden;
    height: clamp(240px, 40vw, 420px);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .narrative {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 700px) {
    .narrative {
      grid-template-columns: 1fr 1fr;
    }
  }

  .narrative-block h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    margin: 0 0 var(--space-3);
    color: var(--text);
  }

  .narrative-block p {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.75;
    margin: 0;
  }

  .narrative-block ul {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .narrative-block li::before {
    content: "▸ ";
    color: var(--accent);
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 700px) {
    .stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stats h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    margin: 0 0 var(--space-3);
    color: var(--text);
  }

  .stats ul {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stats li::before {
    content: "▸ ";
    color: var(--accent);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 12px;
    color: var(--text-muted);
  }

  .radar {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 700px) {
    .radar {
      align-items: flex-start;
    }
    .radar h3 {
      align-self: flex-start;
    }
  }
</style>
