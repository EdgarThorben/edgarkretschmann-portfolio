---
import Base from "../../layouts/Base.astro";
import { projects } from "../../data/projects";

const CONTACT_EMAIL = "hello@edgarkretschmann.com";
const visibleProjects = projects.filter((p) => !p.hidden);
---

<Base
  title="Projects — Edgar Kretschmann"
  description="A detailed showcase of Edgar Kretschmann's projects — from co-living communities to nurse recruitment funnels and online language schools."
  section="projects"
>
  <main class="wrap">
    <div class="head" data-reveal="fade-up">
      <a href="/" class="back-link">← Home</a>
      <h1>Every engagement</h1>
      <p class="lede">
        The complete list, {visibleProjects.length} of them — for the four flagship stories told in full, see{" "}
        <a href="/portfolio">the portfolio →</a>
      </p>
    </div>

    <div class="project-list">
      {
        visibleProjects.map((project, index) => {
          const prev = index > 0 ? visibleProjects[index - 1] : undefined;
          const next = index < visibleProjects.length - 1 ? visibleProjects[index + 1] : undefined;
          return (
            <section id={project.slug} class="project" data-reveal="fade-up" data-reveal-group="projects-list">
              <div class="project-head">
                <span class="project-index">
                  {String(index + 1).padStart(2, "0")} / {String(visibleProjects.length).padStart(2, "0")}
                </span>
                <h2>
                  {project.company}
                  {project.status === "next" && <span class="status-badge">In progress</span>}
                </h2>
                <p class="project-subtitle">{project.title}</p>
              </div>

              <div class="project-body">
                <a
                  class="project-media"
                  href={`/projects/${project.slug}`}
                  aria-label={`View full details: ${project.company}`}
                >
                  <img src={project.projectsHeroImage} alt={project.company} />
                </a>
                <div class="project-text">
                  <p class="project-url">
                    {project.linkUrl ? (
                      <a href={project.linkUrl} target="_blank" rel="noopener noreferrer">
                        {project.url}
                      </a>
                    ) : (
                      project.url
                    )}
                  </p>
                  <p>{project.challenge}</p>

                  <div class="project-grid">
                    <div>
                      <h4>Approach</h4>
                      <ul>
                        {project.approach.map((step) => (
                          <li>{step}</li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <h4>{project.status === "next" ? "What's next" : "Outcome"}</h4>
                      <ul>
                        {project.achievements.map((a) => (
                          <li>{a}</li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <div class="tags">
                    {project.tech.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </div>
                </div>
              </div>

              <div class="nav-strip">
                {prev && <a href={`#${prev.slug}`}>← {prev.company}</a>}
                <a href={`/projects/${project.slug}`} class="nav-strip__details">
                  View full details →
                </a>
                {next && (
                  <a href={`#${next.slug}`} class="nav-strip__next">
                    {next.company} →
                  </a>
                )}
              </div>
            </section>
          );
        })
      }
    </div>

    <!-- Contact -->
    <section id="touch" class="touch" data-reveal="fade-up">
      <h2>Get in touch</h2>
      <form id="contact-form" method="post" action="/api/contact">
        <input type="hidden" name="lang" value="en" />
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required />
        </div>
        <div class="field">
          <label for="siteUrl">Site URL <span class="optional">(optional)</span></label>
          <input id="siteUrl" name="siteUrl" type="url" />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="4" required></textarea>
        </div>
        <button type="submit" class="btn-pill btn-accent submit-btn">Submit</button>
        <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
      </form>
      <div class="touch__alt">
        <a href={`mailto:${CONTACT_EMAIL}`} class="btn-pill btn-ghost">✉ Email me directly</a>
        <a href="/portfolio" class="btn-pill btn-ghost">← Back to Portfolio</a>
        <a href="/bio" class="btn-pill btn-ghost">Bio</a>
      </div>
    </section>
  </main>
</Base>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;
    status.textContent = "Sending…";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!response.ok) throw new Error("Request failed");
      status.textContent = "I will definitely get back to you!";
      form.reset();
    } catch {
      status.textContent = "Something went wrong — email me directly instead.";
    }
  });
</script>

<style>
  .wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
  }

  .head {
    margin-bottom: var(--space-7);
  }

  .head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 500;
    margin: var(--space-4) 0 var(--space-2);
  }

  .head .lede {
    color: var(--text-muted);
    margin: 0;
  }

  .head .lede a {
    color: var(--text);
    font-weight: 600;
  }

  .project-list {
    display: flex;
    flex-direction: column;
  }

  .project {
    padding: var(--space-7) 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 80px;
  }

  .project-head {
    margin-bottom: var(--space-5);
  }

  .project-index {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .project-head h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    margin: var(--space-2) 0 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .status-badge {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 3px 10px;
  }

  .project-subtitle {
    color: var(--text-muted);
    margin: 4px 0 0;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .project-body {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .project-media {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    flex-shrink: 0;
    width: 100%;
    aspect-ratio: 16 / 9;
    transition: opacity 0.2s ease;
  }

  .project-media:hover {
    opacity: 0.85;
  }

  @media (min-width: 768px) {
    .project-media {
      width: 280px;
    }
  }

  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-text {
    flex: 1;
  }

  .project-url {
    font-size: 0.8rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    margin: 0 0 var(--space-3);
  }

  .project-url a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .project-url a:hover {
    border-bottom-color: currentColor;
  }

  .project-text p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0 0 var(--space-3);
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  @media (min-width: 600px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project-grid h4 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text);
    margin: 0 0 var(--space-2);
  }

  .project-grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .project-grid li::before {
    content: "▸ ";
    color: var(--accent);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-4);
  }

  .tag {
    font-size: 0.72rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 10px;
    color: var(--text-muted);
  }

  .nav-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
    font-size: 0.85rem;
    flex-wrap: wrap;
  }

  .nav-strip a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .nav-strip a:hover {
    color: var(--text);
  }

  .nav-strip__details {
    color: var(--text) !important;
    font-weight: 600;
  }

  .nav-strip__next {
    margin-left: auto;
  }

  .touch {
    text-align: center;
    padding: var(--space-8) 0 0;
    border-top: 1px solid var(--line);
    margin-top: var(--space-6);
  }

  .touch h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    margin: var(--space-2) 0 var(--space-6);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 460px;
    margin: 0 auto;
    text-align: left;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .field label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
  }

  .optional {
    font-weight: 400;
    color: var(--text-muted);
  }

  .field input,
  .field textarea {
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    padding: var(--space-2) var(--space-3);
    font: inherit;
  }

  .submit-btn {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  .form-status {
    min-height: 1.2em;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .touch__alt {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
