---
import Base from "../layouts/Base.astro";
import MarketingDiagnostic from "../components/MarketingDiagnostic.astro";
import { projects } from "../data/projects";

const CONTACT_EMAIL = "hello@edgarkretschmann.com";
const visibleProjects = projects.filter((p) => !p.hidden);
const industries = new Set(["Coliving", "Healthcare recruitment", "Language education", "Wellness"]);
const foundingYear = 2018;
const yearsActive = new Date().getFullYear() - foundingYear;
---

<Base title="Edgar Kretschmann" description="AI-augmented marketing systems for SMBs. Munich-based, remote everywhere." section="home">
  <main class="wrap">
    <section class="hero">
      <div class="hero-text">
        <h1 data-reveal="fade-left">
          Marketing systems that get your business <em>in front of the people already looking for it.</em>
        </h1>
        <p class="lede" data-reveal="fade-up">
          Good marketing doesn't start with a bigger budget. It starts with finding the exact audience everyone
          else is ignoring, then building the funnel or product that reaches them fast. I've spent 8 years doing
          exactly that: for coliving communities, wellness retreats, and a nurse-recruitment pipeline into Germany,
          including ventures I've built and run myself. If that's what your business needs next, let's talk.
        </p>
        <div class="cta-row" data-reveal="fade-up">
          <a class="btn btn-primary" href="/portfolio">See the work →</a>
          <a class="btn btn-ghost" href={`mailto:${CONTACT_EMAIL}`}>Get in touch</a>
        </div>
      </div>
      <div class="hero-photo" data-reveal="fade-up">
        <img src="/images/bio/image01.jpg" alt="Edgar Kretschmann" />
      </div>
    </section>

    <section class="strip" data-reveal="fade-up">
      <div class="strip-grid">
        <div><strong>{visibleProjects.length}</strong>Ventures built or scaled</div>
        <div><strong>{industries.size}</strong>Industries served</div>
        <div><strong>{yearsActive}+</strong>Years in growth marketing</div>
        <div><strong>100%</strong>Remote, async delivery</div>
      </div>
    </section>

    <MarketingDiagnostic lang="en" />

    <section class="work" id="work">
      <div class="work-head">
        <h2 data-reveal="fade-left">Selected work</h2>
        <p data-reveal="fade-up">
          One pattern across every engagement: find the underserved audience, then build the funnel or the product
          that reaches them fast, real market research paired with AI production speed.
        </p>
      </div>
      <div class="work-list">
        {
          visibleProjects.map((project, index) => (
            <a class="work-row" href={`/projects/${project.slug}`} data-reveal="fade-up" data-reveal-group="home-work">
              <span class="work-num">{String(index + 1).padStart(2, "0")}</span>
              <span class="work-thumb">
                <img src={project.portfolioImage} alt={project.company} />
              </span>
              <span class="work-info">
                <span class="work-title">
                  {project.company}
                  {project.status === "next" && <span class="status-badge">In progress</span>}
                </span>
                <span class="work-sub">{project.summary}</span>
              </span>
              <span class="work-arrow">→</span>
            </a>
          ))
        }
      </div>
    </section>

    <footer data-reveal="fade-up">
      <div class="footer-grid">
        <div>
          <h3>Let's build the system your business actually needs.</h3>
          <p>{CONTACT_EMAIL} · +49 157 84928200</p>
        </div>
        <a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}`}>Get in touch</a>
      </div>
      <p class="copyright">© Edgar Kretschmann. All rights reserved.</p>
    </footer>
  </main>
</Base>

<style>
  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  .hero {
    padding: var(--space-8) 0 var(--space-7);
    display: flex;
    align-items: center;
    gap: var(--space-7);
  }

  .hero-text {
    flex: 1;
    min-width: 0;
  }

  .hero-photo {
    flex-shrink: 0;
    width: 220px;
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: 500;
    line-height: 1.05;
    margin: var(--space-5) 0 var(--space-5);
    max-width: 15ch;
  }

  h1 em {
    font-style: normal;
    color: var(--text-muted);
  }

  .lede {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 58ch;
    margin: 0 0 var(--space-6);
  }

  .cta-row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 14px 24px;
    border-radius: 100px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .btn-primary {
    background: var(--ink);
    color: var(--bg);
  }

  .btn-ghost {
    border: 1px solid var(--line);
    color: var(--text);
  }

  .btn:hover {
    opacity: 0.75;
  }

  .strip {
    padding: var(--space-6) 0;
  }

  .strip-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
  }

  .strip-grid div {
    font-size: 0.85rem;
    color: var(--text-muted);
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--line);
  }

  .strip-grid strong {
    display: block;
    color: var(--text);
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  .work {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--line);
  }

  .work-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-7);
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .work-head h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 500;
    margin: 0;
    max-width: 20ch;
  }

  .work-head p {
    color: var(--text-muted);
    max-width: 40ch;
    margin: 0;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .work-list {
    display: flex;
    flex-direction: column;
  }

  .work-row {
    display: grid;
    grid-template-columns: 2rem 140px 2fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  .work-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .work-row:hover {
    opacity: 0.6;
  }

  .work-num {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .work-thumb {
    width: 140px;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-2);
  }

  .work-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .work-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: 1.2rem;
    font-weight: 500;
  }

  .status-badge {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 3px 10px;
  }

  .work-sub {
    display: block;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 4px;
  }

  .work-arrow {
    font-size: 1.4rem;
    color: var(--text-muted);
  }

  footer {
    padding: var(--space-8) 0 var(--space-6);
    border-top: 1px solid var(--line);
  }

  .footer-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  footer h3 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 500;
    margin: 0 0 8px;
    max-width: 16ch;
  }

  footer p {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.9rem;
  }

  .copyright {
    margin-top: var(--space-6);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .hero {
      flex-direction: column-reverse;
      gap: var(--space-5);
    }
    .hero-photo {
      width: 140px;
    }
    .strip-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .work-row {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .work-thumb {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
    .work-num,
    .work-arrow {
      display: none;
    }
  }
</style>
