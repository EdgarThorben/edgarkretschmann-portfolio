---
import Base from "../../layouts/Base.astro";
import { getProject } from "../../data/projects";

const FLAGSHIP_SLUGS = ["pflegeplace", "ironandzen", "nomavillage", "innate"];
const flagships = FLAGSHIP_SLUGS.map((slug) => getProject(slug)).filter((p) => p !== undefined);
---

<Base
  title="Portfolio — Edgar Kretschmann"
  description="Four flagship stories by Edgar Kretschmann — the pattern behind every engagement, told in full. For the complete archive, see /projects."
  section="portfolio"
>
  <main class="wrap">
    <section class="head">
      <h1>A few of the stories.</h1>
      <p class="lede">
        Four ventures, one pattern: find the audience everyone else is ignoring, then build the funnel or the
        product that reaches them fast. These are the ones worth telling in full —
        <a href="/projects">every engagement lives on the full list →</a>
      </p>
    </section>

    <section class="stories">
      {
        flagships.map((p, i) => (
          <article class="story" data-reveal="fade-up" data-reveal-group="portfolio-stories">
            <a class="story-media" href={`/projects/${p.slug}`} aria-label={`Read the full case study: ${p.company}`}>
              <img src={p.projectsHeroImage} alt={p.company} loading={i === 0 ? "eager" : "lazy"} />
            </a>
            <div class="story-content">
              <p class="story-eyebrow">
                {p.company} · {p.bioRole} · {p.bioPeriod}
              </p>
              <h2>{p.title}</h2>

              <div class="story-block">
                <span class="story-label">The problem</span>
                <p>{p.challenge}</p>
              </div>

              <div class="story-block">
                <span class="story-label">The plan</span>
                <p>{p.approach[0]}</p>
              </div>

              <div class="story-block story-block--outcome">
                <span class="story-label">The outcome</span>
                <p>{p.achievements[0]}</p>
              </div>

              <a class="story-link" href={`/projects/${p.slug}`}>
                Read the full case study →
              </a>
            </div>
          </article>
        ))
      }
    </section>

    <div class="touch" data-reveal="fade-up">
      <p>Want the complete picture?</p>
      <a href="/projects" class="btn-pill btn-ghost">See every engagement →</a>
      <a href="/projects#touch" class="btn-pill btn-accent">Get in touch</a>
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-7) var(--space-5) var(--space-8);
  }

  .head {
    max-width: 62ch;
    margin-bottom: var(--space-8);
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.1;
    margin: var(--space-4) 0;
    text-wrap: balance;
  }

  .lede {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }

  .lede a {
    color: var(--text);
    font-weight: 600;
  }

  .stories {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .story {
    border-top: 1px solid var(--line);
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .story-media {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    transition: opacity 0.2s ease;
  }

  .story-media:hover {
    opacity: 0.85;
  }

  .story-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story-eyebrow {
    font-family: monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin: 0 0 var(--space-2);
  }

  .story-content h2 {
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 500;
    margin: 0 0 var(--space-5);
    text-wrap: balance;
  }

  .story-block {
    margin-bottom: var(--space-4);
  }

  .story-block p {
    margin: 4px 0 0;
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.7;
    max-width: 62ch;
  }

  .story-block--outcome p {
    color: var(--text);
  }

  .story-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text);
  }

  .story-link {
    display: inline-flex;
    margin-top: var(--space-2);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .story-link:hover {
    color: var(--text-muted);
  }

  .touch {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-8) 0 0;
    margin-top: var(--space-7);
    border-top: 1px solid var(--line);
    flex-direction: column;
    text-align: center;
  }

  .touch p {
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
    font-size: 1rem;
  }

  @media (min-width: 700px) {
    .story {
      flex-direction: row;
      align-items: flex-start;
    }
    .story-media {
      width: 300px;
      flex-shrink: 0;
    }
    .touch {
      flex-direction: row;
    }
    .touch p {
      margin: 0 var(--space-3) 0 0;
    }
  }
</style>
