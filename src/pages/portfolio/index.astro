---
import Base from "../../layouts/Base.astro";
import { projects } from "../../data/projects";
---

<Base
  title="Portfolio — Edgar Kretschmann"
  description="Projects by Edgar Kretschmann — from coliving communities to nurse recruitment funnels and online language schools."
  section="portfolio"
>
  <main>
    {
      projects.map((project, index) => (
        <section class="card" id={`project-${index + 1}`} data-reveal="fade-up" data-reveal-group="portfolio">
          <div class="card__media" data-scroll-speed={index % 2 === 0 ? "2" : "3"}>
            <img src={project.portfolioImage} alt={project.title} />
          </div>
          <div class="card__overlay" />
          <h2 class="card__watermark" aria-hidden="true">
            {project.company}
          </h2>
          <div class="card__content">
            <p class="card__category">{project.title}</p>
            <h3 class="card__company">{project.company}</h3>
            <p class="card__desc">{project.summary}</p>
            <div class="card__actions">
              {index < projects.length - 1 && <a href={`#project-${index + 2}`} class="btn-pill btn-ghost">↓ Next Project</a>}
              <a href={`/projects/${project.slug}`} class="btn-pill btn-accent">
                Check this out in Detail →
              </a>
            </div>
          </div>
        </section>
      ))
    }

    <div class="touch" data-reveal="fade-up">
      <a href="/projects#touch" class="btn-pill btn-accent touch__cta">Get in touch!</a>
    </div>
  </main>
</Base>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-4) var(--space-8);
    background: linear-gradient(135deg, #d4f7e4 0%, #c7e9f3 100%);
  }

  .card {
    position: relative;
    width: 100%;
    max-width: 1100px;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
    min-height: 60vh;
    display: flex;
    align-items: flex-end;
  }

  .card__media {
    position: absolute;
    inset: 0;
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.65) 100%);
  }

  .card__watermark {
    position: absolute;
    left: var(--space-6);
    bottom: var(--space-4);
    margin: 0;
    font-size: clamp(4rem, 12vw, 120px);
    font-weight: 800;
    color: rgba(255, 255, 255, 0.1);
    line-height: 1;
    pointer-events: none;
    z-index: 0;
  }

  .card__content {
    position: relative;
    z-index: 1;
    padding: var(--space-6) var(--space-6) var(--space-7);
    width: 100%;
  }

  @media (min-width: 768px) {
    .card__content {
      padding: var(--space-8) var(--space-7);
    }
  }

  .card__category {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 var(--space-1);
  }

  .card__company {
    color: #fff;
    font-weight: 800;
    font-size: clamp(1.6rem, 4.5vw, 3rem);
    margin: 0 0 var(--space-2);
  }

  .card__desc {
    color: rgba(255, 255, 255, 0.88);
    max-width: 560px;
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    line-height: 1.6;
    margin: 0 0 var(--space-5);
  }

  .card__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
  }

  @media (min-width: 640px) {
    .card__actions {
      flex-direction: row;
    }
  }

  .card__actions .btn-pill {
    border-radius: 8px;
    justify-content: center;
    width: 100%;
  }

  @media (min-width: 640px) {
    .card__actions .btn-pill {
      width: auto;
    }
  }

  .touch {
    display: flex;
    justify-content: center;
    padding: var(--space-6) 0;
  }

  .touch__cta {
    padding: 0 var(--space-6);
    font-size: 1.1rem;
    line-height: 3.25rem;
  }
</style>
