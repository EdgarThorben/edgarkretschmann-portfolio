---
import Base from "../../layouts/Base.astro";
import { projects } from "../../data/projects";
---

<Base
  title="Portfolio — Edgar Kretschmann"
  description="Projects by Edgar Kretschmann — from coliving communities to nurse recruitment funnels and online language schools."
  section="portfolio"
>
  <main class="wrap">
    <section class="head">
      <p class="eyebrow" data-reveal="fade-up">Portfolio</p>
      <h1 data-reveal="fade-left">Six case studies, one pattern.</h1>
      <p class="lede" data-reveal="fade-up">
        Find the underserved audience, then build the funnel and content system that reaches them fast — real market
        research, paired with AI production speed.
      </p>
    </section>

    <div class="work-list">
      {
        projects.map((project, index) => (
          <a class="work-row" href={`/projects/${project.slug}`} data-reveal="fade-up" data-reveal-group="portfolio-list">
            <span class="work-num">{String(index + 1).padStart(2, "0")}</span>
            <span class="work-thumb">
              <img src={project.portfolioImage} alt={project.company} />
            </span>
            <span class="work-info">
              <span class="work-title">{project.company}</span>
              <span class="work-role">{project.title}</span>
              <span class="work-sub">{project.summary}</span>
              <span class="work-tags">
                {project.tech.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </span>
            </span>
            <span class="work-arrow">→</span>
          </a>
        ))
      }
    </div>

    <div class="touch" data-reveal="fade-up">
      <p>Like what you see?</p>
      <a href="/projects#touch" class="btn-pill btn-accent">Get in touch</a>
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-7) var(--space-5) var(--space-8);
  }

  .head {
    max-width: 60ch;
    margin-bottom: var(--space-7);
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 500;
    line-height: 1.1;
    margin: var(--space-4) 0;
  }

  .lede {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }

  .work-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .work-row {
    display: grid;
    grid-template-columns: 2.5rem 180px 1fr auto;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  .work-row:hover {
    opacity: 0.6;
  }

  .work-num {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .work-thumb {
    width: 180px;
    height: 112px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-2);
  }

  .work-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .work-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .work-title {
    font-size: 1.4rem;
    font-weight: 500;
  }

  .work-role {
    font-size: 0.85rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .work-sub {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: 56ch;
    margin: 4px 0 8px;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 0.72rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 10px;
    color: var(--text-muted);
  }

  .work-arrow {
    font-size: 1.5rem;
    color: var(--text-muted);
  }

  .touch {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-8) 0 0;
    flex-direction: column;
    text-align: center;
  }

  .touch p {
    color: var(--text-muted);
    margin: 0;
    font-size: 1rem;
  }

  @media (max-width: 760px) {
    .work-row {
      grid-template-columns: 1fr;
    }
    .work-thumb {
      width: 100%;
      height: 180px;
    }
    .work-num,
    .work-arrow {
      display: none;
    }
  }
</style>
