---
/**
 * TEST PAGE — not linked from navigation, not used by any project data yet.
 * Preview of the "Details" placeholder hero card (see DetailsThumbnail.astro)
 * applied to the 5 projects that don't currently use it, so the design can
 * be reviewed before touching real project data.
 */
import Base from "../layouts/Base.astro";
import DetailsThumbnail from "../components/DetailsThumbnail.astro";
---

<Base title="Thumbnail test · Edgar Kretschmann" description="Draft preview of Details thumbnail cards." section="projects">
  <main class="wrap">
    <div class="head">
      <h1>Thumbnail test — v2</h1>
      <p class="lede">
        Same 5 draft cards, now with real brand assets instead of hand-drawn guesses: Pflegeplace-Hub reuses a
        pixel-cropped export of the actual Pflege Place logo, Iron &amp; Zen is set in the real Marcellus typeface
        sampled from ironandzen.com's own CSS, and IcanSpeak uses the actual logo.svg pulled from their WordPress
        site. Colevitate uses its real Space Grotesk wordmark (the same font this site's own nav already loads) and
        a cropped export of its real gradient icon. NimbusVault has no public brand to match — it's a private
        client tool — so that one stays a deliberate custom mark, just cleaned up.
      </p>
    </div>

    <div class="grid">
      <figure>
        <DetailsThumbnail domain="pflegeplace.com/hub">
          <image href="/images/thumbnail-test/pflegeplace-hub-logo.png" x="0" y="0" width="560" height="191" />
          <text x="4" y="222" font-family="Arial, Helvetica, sans-serif" font-weight="600" font-size="26" letter-spacing="2" fill="#7c89aa">KENNTNISPRÜFUNG HUB</text>
        </DetailsThumbnail>
        <figcaption>Pflegeplace-Hub <span>— no real photo exists yet (in build); real Pflege Place logo, cropped from the existing card</span></figcaption>
      </figure>

      <figure>
        <DetailsThumbnail domain="ironandzen.com">
          <text x="0" y="120" font-family="Marcellus, serif" font-weight="400" font-size="96" letter-spacing="21" fill="#262019">IRON ✦ ZEN</text>
        </DetailsThumbnail>
        <figcaption>Iron &amp; Zen <span>— currently uses a real retreat photo instead; wordmark set in the site's real Marcellus font</span></figcaption>
      </figure>

      <figure>
        <DetailsThumbnail domain="icanspeak.it">
          <image href="/images/thumbnail-test/icanspeak-logo.svg" x="0" y="-30" width="300" height="225" />
        </DetailsThumbnail>
        <figcaption>IcanSpeak <span>— currently uses a real site screenshot instead; real logo.svg pulled from their WordPress uploads</span></figcaption>
      </figure>

      <figure>
        <DetailsThumbnail domain="colevitate.com">
          <image href="/images/thumbnail-test/colevitate-icon.png" x="0" y="34" width="112" height="112" />
          <text x="130" y="118" font-family="'Space Grotesk Variable', 'Space Grotesk', sans-serif" font-weight="700" font-size="80" fill="#10131c">Colevitate</text>
        </DetailsThumbnail>
        <figcaption>Colevitate <span>— currently uses a real app screenshot instead; real gradient icon + real Space Grotesk wordmark</span></figcaption>
      </figure>

      <figure>
        <DetailsThumbnail domain="Private client deployment">
          <rect x="8" y="48" width="64" height="80" rx="10" fill="#334155" />
          <circle cx="40" cy="88" r="11" fill="#94a3b8" />
          <text x="100" y="98" font-family="'Space Grotesk Variable', 'Space Grotesk', sans-serif" font-weight="700" font-size="72" fill="#1e293b">Nimbus<tspan fill="#3b82f6">Vault</tspan></text>
          <text x="100" y="140" font-family="Arial, Helvetica, sans-serif" font-weight="600" font-size="26" letter-spacing="2" fill="#64748b">SINGLE-TENANT CMDB</text>
        </DetailsThumbnail>
        <figcaption>NimbusVault <span>— currently uses a real app screenshot instead; no public brand exists, so this stays a custom mark (now in Space Grotesk to match the rest of this site)</span></figcaption>
      </figure>
    </div>
  </main>
</Base>

<style is:global>
  @import "@fontsource/marcellus";
</style>

<style>
  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
  }

  .head h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    margin: var(--space-4) 0 var(--space-2);
  }

  .lede {
    color: var(--text-muted);
    max-width: 68ch;
    line-height: 1.6;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  @media (min-width: 800px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  figure {
    margin: 0;
  }

  figure :global(svg) {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: 0.85rem;
    font-weight: 600;
  }

  figcaption span {
    font-weight: 400;
    color: var(--text-muted);
  }
</style>
