---
import Base from "../../../layouts/Base.astro";
import { localizeProjects, localizeBonusExperience } from "../../../lib/i18n";
import { sortProjectsDesc } from "../../../lib/timeline";
import Workbench from "../../../components/Workbench.astro";

const timeline = sortProjectsDesc(localizeProjects("de").filter((p) => !p.hidden));
const bonusExperience = localizeBonusExperience("de");
---

<Base
  title="Meine Bio · Edgar Kretschmann"
  description="Die berufliche Bio von Edgar Kretschmann, neueste zuerst, von der heutigen B2B-Leadgenerierung zurück zu fünf Jahren Sprachunterricht."
  section="bio"
  lang="de"
>
  <main class="wrap">
    <a href="/de" class="back-link" data-reveal="fade-up">← Start</a>

    <section class="hero" data-reveal="fade-up">
      <div class="avatar">
        <img src="/images/bio/image01.jpg" alt="Edgar Kretschmann" />
      </div>
      <h1>Meine Bio</h1>
    </section>

    <ol class="timeline">
      {
        timeline.map((project) => (
          <li>
            <a class="entry" href={`/de/projects/${project.slug}`} data-reveal="fade-up" data-reveal-group="bio-timeline">
              <span class="entry-period">{project.bioPeriod}</span>
              <span class="entry-thumb">
                <img src={project.bioImage} alt={project.company} />
              </span>
              <span class="entry-info">
                <span class="entry-role">{project.bioRole}</span>
                <span class="entry-title">
                  {project.company}
                  {project.status === "next" && <span class="status-badge">In Arbeit</span>}
                </span>
                <span class="entry-desc">{project.bioDescription}</span>
              </span>
              <span class="entry-arrow">→</span>
            </a>
          </li>
        ))
      }
      <li>
        <a class="entry entry--bonus" href="/de/bio/teacher" data-reveal="fade-up" data-reveal-group="bio-timeline">
          <span class="entry-period">{bonusExperience.period}</span>
          <span class="entry-thumb">
            <img src={bonusExperience.image} alt={bonusExperience.company} />
          </span>
          <span class="entry-info">
            <span class="entry-role">{bonusExperience.role}</span>
            <span class="entry-title">Bonus: Sprachlehrer</span>
            <span class="entry-desc">{bonusExperience.description}</span>
          </span>
          <span class="entry-arrow">→</span>
        </a>
      </li>
    </ol>

    <Workbench lang="de" />

    <footer data-reveal="fade-up">
      <div class="footer-grid">
        <div>
          <h2>Kontakt aufnehmen</h2>
          <p>hello@edgarkretschmann.com</p>
        </div>
        <div class="footer-actions">
          <a href="mailto:hello@edgarkretschmann.com" class="btn-pill btn-accent">E-Mail schreiben</a>
          <a href="/de/projects#touch" class="btn-pill btn-ghost">Mehr Details</a>
        </div>
      </div>
    </footer>
  </main>
</Base>

<style>
  .wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-6) 0 var(--space-5);
  }

  .avatar {
    width: 6rem;
    height: 6rem;
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid var(--line);
    margin-bottom: var(--space-4);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    font-weight: 500;
    margin: var(--space-2) 0 0;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .entry {
    display: grid;
    grid-template-columns: 90px 104px 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  a.entry:hover {
    opacity: 0.6;
  }

  .entry-period {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .entry-thumb {
    width: 104px;
    aspect-ratio: 1;
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-2);
  }

  .entry-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .entry-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .entry-role {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    font-weight: 600;
  }

  .entry-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: 1.3rem;
    font-weight: 500;
  }

  .status-badge {
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 2px 9px;
  }

  .entry-desc {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
    margin-top: 4px;
    max-width: 52ch;
  }

  .entry-arrow {
    font-size: 1.3rem;
    color: var(--text-muted);
  }

  footer {
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .footer-grid {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  footer h2 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 500;
    margin: 0 0 4px;
  }

  footer p {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.9rem;
  }

  .footer-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  @media (max-width: 700px) {
    .entry {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .entry-thumb {
      width: 100%;
      max-width: 220px;
      aspect-ratio: 1;
    }
    .entry-arrow {
      display: none;
    }
  }
</style>
