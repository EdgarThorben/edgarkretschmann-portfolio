---
import Base from "../../layouts/Base.astro";
import MarketingDiagnostic from "../../components/MarketingDiagnostic.astro";
import { localizeProjects } from "../../lib/i18n";
import { ui } from "../../i18n/ui";

const CONTACT_EMAIL = "hello@edgarkretschmann.com";
const t = ui.de;
const projects = localizeProjects("de");
const visibleProjects = projects.filter((p) => !p.hidden);
const industries = new Set(["Coliving", "Pflegekräfte-Recruiting", "Sprachbildung", "Wellness"]);
const foundingYear = 2018;
const yearsActive = new Date().getFullYear() - foundingYear;
---

<Base
  title="Edgar Kretschmann"
  description="KI-gestützte Marketing-Systeme für KMU. Aus München, weltweit unterwegs."
  section="home"
  lang="de"
>
  <main class="wrap">
    <section class="hero">
      <div class="hero-text">
        <h1 data-reveal="fade-left">
          Marketing-Systeme, die dein Unternehmen <em>vor die Menschen bringen, die schon danach suchen.</em>
        </h1>
        <p class="lede" data-reveal="fade-up">
          Gutes Marketing beginnt nicht mit mehr Budget, sondern damit, die eine Zielgruppe zu finden, die alle
          anderen ignorieren, und dann schnell den Funnel oder das Produkt zu bauen, das sie erreicht. Genau das
          mache ich seit 8 Jahren: für Coliving-Communities, Wellness-Retreats und eine Pflegekräfte-Pipeline nach
          Deutschland, darunter Projekte, die ich selbst gegründet und geführt habe. Wenn genau das dein
          Unternehmen als Nächstes braucht, lass uns reden.
        </p>
        <div class="cta-row" data-reveal="fade-up">
          <a class="btn btn-primary" href="/de/portfolio">Zu den Arbeiten →</a>
          <a class="btn btn-ghost" href={`mailto:${CONTACT_EMAIL}`}>Kontakt aufnehmen</a>
        </div>
      </div>
      <div class="hero-photo" data-reveal="fade-up">
        <img src="/images/bio/image01.jpg" alt="Edgar Kretschmann" />
      </div>
    </section>

    <section class="strip" data-reveal="fade-up">
      <div class="strip-grid">
        <div><strong>{visibleProjects.length}</strong>Projekte aufgebaut oder skaliert</div>
        <div><strong>{industries.size}</strong>Branchen bedient</div>
        <div><strong>{yearsActive}+</strong>Jahre im Growth Marketing</div>
        <div><strong>100%</strong>Remote, asynchrone Umsetzung</div>
      </div>
    </section>

    <MarketingDiagnostic lang="de" />

    <section class="work" id="work">
      <div class="work-head">
        <h2 data-reveal="fade-left">Ausgewählte Arbeiten</h2>
        <p data-reveal="fade-up">
          Ein Muster zieht sich durch jedes Projekt: die unterversorgte Zielgruppe finden, dann den Funnel oder das
          Produkt bauen, das sie schnell erreicht, echte Marktrecherche gepaart mit KI-Produktionsgeschwindigkeit.
        </p>
      </div>
      <div class="work-list">
        {
          visibleProjects.map((project, index) => (
            <a class="work-row" href={`/de/projects/${project.slug}`} data-reveal="fade-up" data-reveal-group="home-work">
              <span class="work-num">{String(index + 1).padStart(2, "0")}</span>
              <span class="work-thumb">
                <img src={project.portfolioImage} alt={project.company} />
              </span>
              <span class="work-info">
                <span class="work-title">
                  {project.company}
                  {project.status === "next" && <span class="status-badge">{t.project.inProgress}</span>}
                </span>
                <span class="work-sub">{project.summary}</span>
              </span>
              <span class="work-arrow">→</span>
            </a>
          ))
        }
      </div>
    </section>

    <footer data-reveal="fade-up">
      <div class="footer-grid">
        <div>
          <h3>Lass uns das System bauen, das dein Unternehmen wirklich braucht.</h3>
          <p>{CONTACT_EMAIL} · +49 157 84928200</p>
        </div>
        <a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}`}>Kontakt aufnehmen</a>
      </div>
      <p class="copyright">© Edgar Kretschmann. Alle Rechte vorbehalten.</p>
    </footer>
  </main>
</Base>

<style>
  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  .hero {
    padding: var(--space-8) 0 var(--space-7);
    display: flex;
    align-items: center;
    gap: var(--space-7);
  }

  .hero-text {
    flex: 1;
    min-width: 0;
  }

  .hero-photo {
    flex-shrink: 0;
    width: 220px;
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: 500;
    line-height: 1.05;
    margin: var(--space-5) 0 var(--space-5);
    max-width: 20ch;
  }

  h1 em {
    font-style: normal;
    color: var(--text-muted);
  }

  .lede {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 58ch;
    margin: 0 0 var(--space-6);
  }

  .cta-row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 14px 24px;
    border-radius: 100px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .btn-primary {
    background: var(--ink);
    color: var(--bg);
  }

  .btn-ghost {
    border: 1px solid var(--line);
    color: var(--text);
  }

  .btn:hover {
    opacity: 0.75;
  }

  .strip {
    padding: var(--space-6) 0;
  }

  .strip-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
  }

  .strip-grid div {
    font-size: 0.85rem;
    color: var(--text-muted);
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--line);
  }

  .strip-grid strong {
    display: block;
    color: var(--text);
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  .work {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--line);
  }

  .work-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-7);
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .work-head h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 500;
    margin: 0;
    max-width: 20ch;
  }

  .work-head p {
    color: var(--text-muted);
    max-width: 40ch;
    margin: 0;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .work-list {
    display: flex;
    flex-direction: column;
  }

  .work-row {
    display: grid;
    grid-template-columns: 2rem 140px 2fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  .work-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .work-row:hover {
    opacity: 0.6;
  }

  .work-num {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .work-thumb {
    width: 140px;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-2);
  }

  .work-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .work-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: 1.2rem;
    font-weight: 500;
  }

  .status-badge {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 3px 10px;
  }

  .work-sub {
    display: block;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: 4px;
  }

  .work-arrow {
    font-size: 1.4rem;
    color: var(--text-muted);
  }

  footer {
    padding: var(--space-8) 0 var(--space-6);
    border-top: 1px solid var(--line);
  }

  .footer-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  footer h3 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 500;
    margin: 0 0 8px;
    max-width: 18ch;
  }

  footer p {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.9rem;
  }

  .copyright {
    margin-top: var(--space-6);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .hero {
      flex-direction: column-reverse;
      gap: var(--space-5);
    }
    .hero-photo {
      width: 140px;
    }
    .strip-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .work-row {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .work-thumb {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
    .work-num,
    .work-arrow {
      display: none;
    }
  }
</style>
