---
import Base from "../../../layouts/Base.astro";
import { localizeProjects, localizeProject } from "../../../lib/i18n";
import { ui } from "../../../i18n/ui";

const CONTACT_EMAIL = "hello@edgarkretschmann.com";
const t = ui.de;
const visibleProjects = localizeProjects("de").filter((p) => !p.hidden);

const FLAGSHIP_SLUGS = ["pflegeplace", "ironandzen", "nomavillage", "innate"];
const flagships = FLAGSHIP_SLUGS.map((slug) => localizeProject(slug, "de")).filter((p) => p !== undefined);
---

<Base
  title="Projekte · Edgar Kretschmann"
  description="Ein detaillierter Einblick in Edgar Kretschmanns Projekte, von Coliving-Communities über Recruiting-Funnels für Pflegekräfte bis zu Online-Sprachschulen."
  section="projects"
  lang="de"
>
  <main class="wrap">
    <div class="head" data-reveal="fade-up">
      <a href="/de" class="back-link">← Start</a>
      <h1>Jedes Engagement</h1>
      <p class="lede">
        Zehn Jahre freiberufliche Arbeit, {visibleProjects.length} Projekte insgesamt. Vier Vorzeigeprojekte
        ausführlich erzählt weiter unten, dann das komplette Archiv.
      </p>
    </div>

    <section class="stories" aria-label="Ausgewählte Geschichten">
      <h2 class="section-heading">Ausgewählte Geschichten</h2>
      {
        flagships.map((p, i) => (
          <article class="story" data-reveal="fade-up" data-reveal-group="portfolio-stories">
            <a class="story-media" href={`/de/projects/${p.slug}`} aria-label={`Ganze Case Study lesen: ${p.company}`}>
              <img src={p.projectsHeroImage} alt={p.company} loading={i === 0 ? "eager" : "lazy"} />
            </a>
            <div class="story-content">
              <p class="story-eyebrow">
                {p.company} · {p.bioRole} · {p.bioPeriod}
              </p>
              <h3>{p.title}</h3>

              <div class="story-block">
                <span class="story-label">Die Herausforderung</span>
                <p>{p.challenge}</p>
              </div>

              <div class="story-block">
                <span class="story-label">Der Plan</span>
                <p>{p.approach[0]}</p>
              </div>

              <div class="story-block story-block--outcome">
                <span class="story-label">Das Ergebnis</span>
                <p>{p.achievements[0]}</p>
              </div>

              <a class="story-link" href={`/de/projects/${p.slug}`}>
                Ganze Case Study lesen →
              </a>
            </div>
          </article>
        ))
      }
    </section>

    <div class="project-list">
      <h2 class="section-heading">Das komplette Archiv</h2>
      {
        visibleProjects.map((project, index) => {
          const prev = index > 0 ? visibleProjects[index - 1] : undefined;
          const next = index < visibleProjects.length - 1 ? visibleProjects[index + 1] : undefined;
          return (
            <section id={project.slug} class="project" data-reveal="fade-up" data-reveal-group="projects-list">
              <div class="project-head">
                <span class="project-index">
                  {String(index + 1).padStart(2, "0")} / {String(visibleProjects.length).padStart(2, "0")}
                </span>
                <h2>
                  {project.company}
                  {project.status === "next" && <span class="status-badge">{t.project.inProgress}</span>}
                </h2>
                <p class="project-subtitle">{project.title}</p>
              </div>

              <div class="project-body">
                <a
                  class="project-media"
                  href={`/de/projects/${project.slug}`}
                  aria-label={`${t.project.viewFullDetails}: ${project.company}`}
                >
                  <img src={project.projectsHeroImage} alt={project.company} />
                </a>
                <div class="project-text">
                  <p class="project-url">
                    {project.linkUrl ? (
                      <a href={project.linkUrl} target="_blank" rel="noopener noreferrer">
                        {project.url}
                      </a>
                    ) : (
                      project.url
                    )}
                  </p>
                  <p>{project.challenge}</p>

                  <div class="project-grid">
                    <div>
                      <h4>{t.project.theApproach}</h4>
                      <ul>
                        {project.approach.map((step) => (
                          <li>{step}</li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <h4>{project.status === "next" ? t.project.whatsNext : t.project.outcome}</h4>
                      <ul>
                        {project.achievements.map((a) => (
                          <li>{a}</li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <div class="tags">
                    {project.tech.map((tech) => (
                      <span class="tag">{tech}</span>
                    ))}
                  </div>
                </div>
              </div>

              <div class="nav-strip">
                {prev && <a href={`#${prev.slug}`}>← {prev.company}</a>}
                <a href={`/de/projects/${project.slug}`} class="nav-strip__details">
                  {t.project.viewFullDetails}
                </a>
                {next && (
                  <a href={`#${next.slug}`} class="nav-strip__next">
                    {next.company} →
                  </a>
                )}
              </div>
            </section>
          );
        })
      }
    </div>

    <!-- Contact -->
    <section id="touch" class="touch" data-reveal="fade-up">
      <h2>{t.contact.heading}</h2>
      <form id="contact-form" method="post" action="/api/contact">
        <input type="hidden" name="lang" value="de" />
        <div class="field">
          <label for="name">{t.contact.name}</label>
          <input id="name" name="name" type="text" required />
        </div>
        <div class="field">
          <label for="email">{t.contact.email}</label>
          <input id="email" name="email" type="email" required />
        </div>
        <div class="field">
          <label for="siteUrl">{t.contact.siteUrl} <span class="optional">{t.contact.optional}</span></label>
          <input id="siteUrl" name="siteUrl" type="url" />
        </div>
        <div class="field">
          <label for="message">{t.contact.message}</label>
          <textarea id="message" name="message" rows="4" required></textarea>
        </div>
        <button type="submit" class="btn-pill btn-accent submit-btn">{t.contact.submit}</button>
        <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
      </form>
      <div class="touch__alt">
        <a href={`mailto:${CONTACT_EMAIL}`} class="btn-pill btn-ghost">{t.contact.emailDirect}</a>
        <a href="/de/bio" class="btn-pill btn-ghost">{t.contact.bio}</a>
      </div>
    </section>
  </main>
</Base>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;
    status.textContent = "Wird gesendet…";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!response.ok) throw new Error("Request failed");
      status.textContent = "Ich melde mich auf jeden Fall bei dir!";
      form.reset();
    } catch {
      status.textContent = "Etwas ist schiefgelaufen. Schreib mir stattdessen direkt eine E-Mail.";
    }
  });
</script>

<style>
  .wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
  }

  .head {
    margin-bottom: var(--space-7);
  }

  .head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 500;
    margin: var(--space-4) 0 var(--space-2);
  }

  .head .lede {
    color: var(--text-muted);
    margin: 0;
  }

  .head .lede a {
    color: var(--text);
    font-weight: 600;
  }

  .section-heading {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0 0 var(--space-5);
  }

  .stories {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--line);
  }

  .story {
    border-top: 1px solid var(--line);
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .stories .story:first-of-type {
    border-top: none;
    padding-top: 0;
  }

  .story-media {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    transition: opacity 0.2s ease;
  }

  .story-media:hover {
    opacity: 0.85;
  }

  .story-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story-eyebrow {
    font-family: monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin: 0 0 var(--space-2);
  }

  .story-content h3 {
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 500;
    margin: 0 0 var(--space-5);
    text-wrap: balance;
  }

  .story-block {
    margin-bottom: var(--space-4);
  }

  .story-block p {
    margin: 4px 0 0;
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.7;
    max-width: 62ch;
  }

  .story-block--outcome p {
    color: var(--text);
  }

  .story-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text);
  }

  .story-link {
    display: inline-flex;
    margin-top: var(--space-2);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .story-link:hover {
    color: var(--text-muted);
  }

  @media (min-width: 700px) {
    .story {
      flex-direction: row;
      align-items: flex-start;
    }
    .story-media {
      width: 300px;
      flex-shrink: 0;
    }
  }

  .project-list {
    display: flex;
    flex-direction: column;
  }

  .project {
    padding: var(--space-7) 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 80px;
  }

  .project-head {
    margin-bottom: var(--space-5);
  }

  .project-index {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .project-head h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    margin: var(--space-2) 0 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .status-badge {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 3px 10px;
  }

  .project-subtitle {
    color: var(--text-muted);
    margin: 4px 0 0;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .project-body {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .project-media {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    flex-shrink: 0;
    width: 100%;
    aspect-ratio: 16 / 9;
    transition: opacity 0.2s ease;
  }

  .project-media:hover {
    opacity: 0.85;
  }

  @media (min-width: 768px) {
    .project-media {
      width: 280px;
    }
  }

  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-text {
    flex: 1;
  }

  .project-url {
    font-size: 0.8rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    margin: 0 0 var(--space-3);
  }

  .project-url a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .project-url a:hover {
    border-bottom-color: currentColor;
  }

  .project-text p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0 0 var(--space-3);
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  @media (min-width: 600px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project-grid h4 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text);
    margin: 0 0 var(--space-2);
  }

  .project-grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .project-grid li::before {
    content: "▸ ";
    color: var(--accent);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-4);
  }

  .tag {
    font-size: 0.72rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 10px;
    color: var(--text-muted);
  }

  .nav-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
    font-size: 0.85rem;
    flex-wrap: wrap;
  }

  .nav-strip a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .nav-strip a:hover {
    color: var(--text);
  }

  .nav-strip__details {
    color: var(--text) !important;
    font-weight: 600;
  }

  .nav-strip__next {
    margin-left: auto;
  }

  .touch {
    text-align: center;
    padding: var(--space-8) 0 0;
    border-top: 1px solid var(--line);
    margin-top: var(--space-6);
  }

  .touch h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    margin: var(--space-2) 0 var(--space-6);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 460px;
    margin: 0 auto;
    text-align: left;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .field label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
  }

  .optional {
    font-weight: 400;
    color: var(--text-muted);
  }

  .field input,
  .field textarea {
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    padding: var(--space-2) var(--space-3);
    font: inherit;
  }

  .submit-btn {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  .form-status {
    min-height: 1.2em;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .touch__alt {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
