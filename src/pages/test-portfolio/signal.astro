---
import { getProject } from "../../data/projects";

const order = ["deutschacademy", "pflegeplace", "icanspeak", "innate", "nomavillage", "narangyoga"];
const items = order.map((slug, i) => ({ ...getProject(slug)!, num: String(i + 1).padStart(2, "0") }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Test: Signal — Portfolio Concept</title>
  </head>
  <body>
    <div class="page">
      <header class="head">
        <p class="eyebrow">Edgar Kretschmann &mdash; Growth &amp; Community</p>
        <h1>Quiet channels.<br />Loud results.</h1>
      </header>

      <section class="grid">
        {
          items.map((p, i) => (
            <a class="item" href={`#`} style={i % 3 === 1 ? "grid-row: span 2;" : ""} data-observe>
              <div class="item-image"><img src={p.portfolioImage} alt="" loading="lazy" /></div>
              <div class="item-cap">
                <span class="item-num">{p.num}</span>
                <span class="item-name">{p.company}</span>
                <span class="item-title">{p.title}</span>
                <span class="item-period">{p.bioPeriod}</span>
              </div>
            </a>
          ))
        }
      </section>

      <footer class="foot">
        <p>Design concept for edgarkretschmann.com/portfolio &mdash; minimal / award-style direction. <a href="/test-portfolio">&larr; all concepts</a></p>
      </footer>
    </div>
    <script>
      const els = document.querySelectorAll("[data-observe]");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) e.target.classList.add("in");
        },
        { threshold: 0.01, rootMargin: "0px 0px 100px 0px" }
      );
      els.forEach((el) => io.observe(el));
      // Safety net: never leave items stuck below full opacity.
      setTimeout(() => els.forEach((el) => el.classList.add("in")), 1200);
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #FBFBFA;
    --ink: #111113;
    --muted: #7A7A7E;
    --accent: #2F5CFF;
    --line: rgba(17,17,19,0.1);
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0C0C0D; --ink: #F2F2F0; --muted: #8C8C90; --accent: #6C8CFF; --line: rgba(242,242,240,0.12); }
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body { background: var(--bg); color: var(--ink); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; overflow-x: hidden; }
  .page { max-width: 1180px; margin: 0 auto; padding: 64px 32px 100px; }
  .head { max-width: 720px; margin-bottom: 72px; }
  .eyebrow { font-size: 0.78rem; letter-spacing: 0.06em; color: var(--muted); margin: 0 0 18px; text-transform: uppercase; }
  h1 {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; grid-auto-rows: 220px; }

  .item {
    position: relative; display: block; text-decoration: none; color: inherit;
    opacity: 0.55; transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .item.in { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .item { opacity: 1; transform: none; transition: none; } }

  .item-image { position: relative; width: 100%; height: 100%; overflow: hidden; background: var(--line); }
  .item-image img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; filter: grayscale(1) contrast(1.05); }
  .item:hover .item-image img { transform: scale(1.045); filter: grayscale(0); }

  .item-cap { display: flex; align-items: baseline; gap: 10px; margin-top: 12px; flex-wrap: wrap; }
  .item-num { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.7rem; color: var(--accent); font-variant-numeric: tabular-nums; }
  .item-name { font-weight: 600; font-size: 1rem; }
  .item-title { font-size: 0.85rem; color: var(--muted); font-style: italic; font-family: Georgia, serif; }
  .item-period { margin-left: auto; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.68rem; color: var(--muted); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; grid-auto-rows: 260px; }
    .item { grid-row: span 1 !important; }
  }

  .foot { margin-top: 90px; padding-top: 20px; border-top: 1px solid var(--line); }
  .foot p { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.68rem; color: var(--muted); margin: 0; }
  .foot a { color: var(--accent); }
</style>
